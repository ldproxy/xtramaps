{
  "name": "xtramaps",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldproxy/xtramaps.git"
  },
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/core/*",
    "packages/react/*",
    "packages/vue/*",
    "packages/svelte/*"
  ],
  "scripts": {
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "prepare": "lefthook install",
    "upgrade": "ncu --workspaces --root --interactive --format group",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pretest": "playwright install chromium",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/node": "24.19.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "bootstrap": "5.3.8",
    "lefthook": "2.2.2",
    "npm-check-updates": "19.6.6",
    "playwright": "1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.4",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.12"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
